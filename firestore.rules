rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // `role` is a UI/routing hint, not a security boundary — writes here are
    // already gated by uid ownership regardless of what role a doc claims.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /providers/{providerId} {
      allow read: if true;
      allow write: if isOwner(providerId);

      match /services/{serviceId} {
        allow read: if true;
        allow write: if isOwner(providerId);
      }
    }

    match /bookings/{bookingId} {
      allow create: if isSignedIn()
                    && request.resource.data.clientUid == request.auth.uid;
      allow read, update: if isSignedIn()
                    && (resource.data.clientUid == request.auth.uid
                        || resource.data.providerId == request.auth.uid);
      allow delete: if false;
    }
  }
}
